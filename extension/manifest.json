{
  "manifest_version": 3,
  "name": "Privacy-Preserving Vision Agent",
  "version": "0.1.0",
  "description": "Automates browser tasks from plain-language instructions while redacting passwords, card numbers and PII before any AI sees them.",
  "action": {},
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "tabs",
    "offscreen",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
