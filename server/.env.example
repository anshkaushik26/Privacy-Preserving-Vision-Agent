GEMINI_API_KEY=your_key_here
# optional, defaults to gemini-flash-lite-latest - a rolling alias to
# Google's current lite flash model, so it won't go stale like a pinned
# version can. Free tier: gemini-3.6-flash (the newest full flash model) is
# capped at just 5 requests/minute, too tight for a multi-step agent loop;
# the lite alias has a much higher free quota (verified: 8+ rapid calls OK).
# GEMINI_MODEL=gemini-flash-lite-latest
